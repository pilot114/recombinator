  "06-symfony-demo": {
    "name": "Symfony Demo",
    "schedule": "sequential",
    "type": "project",
    "entry": "public/index.php",
    "description": "Полноценное Symfony-приложение — блог с аутентификацией, комментариями и админкой. Реальный production-код: контроллеры, сервисы, Doctrine, Twig",
    "url": "https://github.com/symfony/demo",
    "setup": [
      "echo 'APP_ENV=prod' > .env.local",
      "echo 'APP_SECRET=12345qwerty' >> .env.local",
      "composer install --no-dev --optimize-autoloader --no-scripts",
      "php bin/console importmap:install",
      "php bin/console sass:build",
      "php bin/console asset-map:compile"
    ]
  },
  "07-slim-demo": {
    "name": "Slim Demo",
    "schedule": "sequential",
    "type": "project",
    "entry": "public/index.php",
    "description": "Приложение на Slim",
    "url": "https://github.com/1ma/Slim-Doctrine-Demo",
    "setup": [
      "composer install --no-dev --optimize-autoloader --no-scripts --ignore-platform-reqs",
      "cp settings.php.dist settings.php"
    ],
    "environment": {
      "php": "8.5.10",
      "os": "Linux",
      "entry": "{project}/public/index.php",
      "extensions": [
        "Core",
        "ctype",
        "date",
        "dom",
        "fileinfo",
        "filter",
        "hash",
        "iconv",
        "intl",
        "json",
        "lexbor",
        "libxml",
        "mbstring",
        "openssl",
        "pcre",
        "PDO",
        "pdo_sqlite",
        "random",
        "Reflection",
        "session",
        "SimpleXML",
        "SPL",
        "standard",
        "tokenizer",
        "uri",
        "xml",
        "xmlreader",
        "xmlwriter",
        "Zend OPcache",
        "zlib"
      ],
      "assumptions": {
        "containerEntriesImmutable": true
      },
      "probes": {
        "doctrine": "$cnt = require 'bootstrap.php'; $cnt->register(new UMA\\DoctrineDemo\\DI\\Doctrine()); return $cnt->get(Doctrine\\ORM\\EntityManager::class);"
      },
      "invariants": {
        "Doctrine_ORM_Configuration": {
          "isNativeLazyObjectsEnabled()": true
        }
      },
      "profile": [
        {
          "method": "GET",
          "uri": "/users"
        },
        {
          "method": "POST",
          "uri": "/users"
        },
        {
          "method": "GET",
          "uri": "/nope"
        }
      ],
      "ini": {
        "sys_temp_dir": "/tmp"
      },
      "env": {
        "DOCTRINE_DEPRECATIONS": null
      },
      "warmup": [
        "UMA_DIC_Container->get('Doctrine_ORM_EntityManager')",
        "UMA_DIC_Container->get('Doctrine_ORM_EntityManager')->getClassMetadata('UMA_DoctrineDemo_Domain_User')",
        "UMA_DIC_Container->get('UMA_DoctrineDemo_Action_ListUsers')",
        "UMA_DIC_Container->get('UMA_DoctrineDemo_Action_CreateUser')"
      ]
    }
  },
  "08-syntax-zoo": {
    "name": "Syntax Zoo",
    "schedule": "priority",
    "type": "project",
    "entry": "index.php",
    "description": "Синтетический пример: >5 классов под одним namespace, покрывает большую часть синтаксиса PHP 8.4 (abstract/final/readonly, trait, interface, enum, generators, match, named args, varargs, spread, magic methods, try/catch/finally, heredoc/nowdoc, first-class callable, nullsafe, late static binding). Удобен для тестирования правил оптимизатора."
  }
}
