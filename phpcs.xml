<?xml version="1.0"?>
<ruleset name="Recombinator">
    <description>PHPCS rules for Recombinator project</description>

    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>

    <!-- PSR-12, длина строки не проверяется -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Mixed line endings in tests are OK -->
    <rule ref="Generic.Files.LineEndings">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Exclude test fixtures from most rules -->
    <exclude-pattern>tests/Feature/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Feature/snapshots/*</exclude-pattern>
    <exclude-pattern>tests/code/*</exclude-pattern>

    <!-- Pest tests have side effects by design -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Allow mixed line endings in some files -->
    <rule ref="Generic.Files.LineEndings">
        <exclude-pattern>src/Domain/FunctionCandidate.php</exclude-pattern>
    </rule>

    <!-- Предупреждения видны в отчёте, но check не роняют. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Мелкие классы-значения живут рядом с единственным, кто ими пользуется. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>src/Support/Inliner.php</exclude-pattern>
    </rule>

    <!-- Среда снимка кучи вставляется в начало плоской программы (глобальное пространство
         имён): префикс __rcb_ не даёт её именам совпасть с именами программы. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>src/Support/snapshot-runtime.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotPascalCase">
        <exclude-pattern>src/Support/snapshot-runtime.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>src/Support/snapshot-runtime.php</exclude-pattern>
    </rule>
</ruleset>
