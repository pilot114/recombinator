			message: '#^Class PhpParser\\Node\\Stmt\\Throw_ not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/Transformation/Visitor/ForeachLiteralUnrollerVisitor.php

		-
			message: '#^Parameter \#3 \$replacement of method Recombinator\\Transformation\\Visitor\\ForeachLiteralUnrollerVisitor\:\:substitute\(\) expects PhpParser\\Node\\Expr, PhpParser\\Node given\.$#'
			identifier: argument.type
			count: 2
			path: src/Transformation/Visitor/ForeachLiteralUnrollerVisitor.php

		-
			message: '#^Cannot access offset ''keyIdx'' on int\|string\.$#'
			identifier: offsetAccess.nonOffsetAccessible
