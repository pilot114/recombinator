parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$code of method PhpParser\\Parser\:\:parse\(\) expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Property PhpParser\\Node\\Expr\\ClassConstFetch\:\:\$class \(PhpParser\\Node\\Expr\|PhpParser\\Node\\Name\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Property PhpParser\\Node\\Expr\\Instanceof_\:\:\$class \(PhpParser\\Node\\Expr\|PhpParser\\Node\\Name\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Property PhpParser\\Node\\Expr\\New_\:\:\$class \(PhpParser\\Node\\Expr\|PhpParser\\Node\\Name\|PhpParser\\Node\\Stmt\\Class_\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Property PhpParser\\Node\\Expr\\StaticCall\:\:\$class \(PhpParser\\Node\\Expr\|PhpParser\\Node\\Name\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Property PhpParser\\Node\\Expr\\StaticPropertyFetch\:\:\$class \(PhpParser\\Node\\Expr\|PhpParser\\Node\\Name\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Inliner.php

		-
			message: '#^Access to an uninitialized property Recombinator\\Support\\Window\:\:\$height\.$#'
			identifier: property.uninitialized
			count: 4
			path: src/Support/WindowComposer.php

		-
			message: '#^Access to an uninitialized property Recombinator\\Support\\Window\:\:\$width\.$#'
			identifier: property.uninitialized
			count: 4
			path: src/Support/WindowComposer.php

		-
			message: '#^Cannot use array destructuring on mixed\.$#'
			identifier: offsetAccess.nonArray
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Class Recombinator\\Support\\Window has an uninitialized property \$height\. Give it default value or assign it in the constructor\.$#'
			identifier: property.uninitialized
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Class Recombinator\\Support\\Window has an uninitialized property \$width\. Give it default value or assign it in the constructor\.$#'
			identifier: property.uninitialized
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#1 \$width of method Recombinator\\Support\\Window\:\:setFixedDimensions\(\) expects int, int\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#2 \$callback of function usort expects callable\(mixed, mixed\)\: int, Closure\(Recombinator\\Support\\Window, Recombinator\\Support\\Window\)\: int\<\-1, 1\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#2 \$count of function array_fill expects int, int\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#2 \$height of method Recombinator\\Support\\Window\:\:setFixedDimensions\(\) expects int, int\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#2 \$start of function mb_substr expects int, \(float\|int\) given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#2 \$times of function str_repeat expects int, int\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#3 \$height of method Recombinator\\Support\\WindowComposer\:\:addVerticalSeparator\(\) expects int, int\|null given\.$#'
			identifier: argument.type
			count: 2
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#3 \$length of function mb_substr expects int\|null, \(float\|int\) given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \#3 \$width of method Recombinator\\Support\\WindowComposer\:\:addHorizontalSeparator\(\) expects int, int\|null given\.$#'
			identifier: argument.type
			count: 2
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \$terminalHeight of class Recombinator\\Support\\Window constructor expects int, int\|null given\.$#'
			identifier: argument.type
			count: 4
			path: src/Support/WindowComposer.php

		-
			message: '#^Parameter \$terminalWidth of class Recombinator\\Support\\Window constructor expects int, int\|null given\.$#'
			identifier: argument.type
			count: 4
			path: src/Support/WindowComposer.php

		-
			message: '#^Property Recombinator\\Support\\Window\:\:\$position type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Property Recombinator\\Support\\WindowComposer\:\:\$separators type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Property Recombinator\\Support\\WindowComposer\:\:\$windows type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/WindowComposer.php

		-
			message: '#^Cannot use \+\+ on mixed\.$#'
			identifier: postInc.type
			count: 2
			path: src/Transformation/Visitor/BoundedWhileUnrollerVisitor.php

		-
			message: '#^Cannot use \-\- on mixed\.$#'
			identifier: postDec.type
			count: 2
			path: src/Transformation/Visitor/BoundedWhileUnrollerVisitor.php

		-
			message: '#^Unary operation "\-" on bool\|float\|int\|string results in an error\.$#'
